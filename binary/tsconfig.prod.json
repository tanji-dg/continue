{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // プロダクションビルド専用の基本最適化のみ適用
    "sourceMap": false,
    "declaration": false,
    "declarationMap": false,
    "removeComments": true
    // 厳しい型チェックは一時的にコメントアウト
    // "noImplicitReturns": true,
